spring.application.name=demo
server.port=8080

# CONFIGURACIÓN DE BASE DE DATOS (MySQL)

spring.datasource.url=jdbc:mysql://localhost:3306/db_boletos
spring.datasource.username=root
spring.datasource.password=TzMySQL^^!

# CONFIGURACIÓN DE JPA / HIBERNATE

# 'update' hace que Hibernate cree o actualice las tablas automáticamente según tus clases Java
spring.jpa.hibernate.ddl-auto=update

# 'true' muestra en la consola de IntelliJ las consultas SQL que Hibernate ejecuta (muy útil para ver qué pasa)
spring.jpa.show-sql=true

# Dialecto para Spring Boot 3
spring.jpa.properties.hibernate.dialect=org.hibernate.dialect.MySQLDialect

# Configuración de Correo Electrónico (Gmail SMTP)
spring.mail.host=smtp.gmail.com
spring.mail.port=587
